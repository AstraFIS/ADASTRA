# OPTIONAL. Defaults live in src/config/settings.ts; any variable set here
# (or in the hosting platform) overrides the corresponding setting.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
MONGODB_URI=
MONGODB_DB_NAME=adastra
JWT_SECRET=
JWT_EXPIRES_IN=7d

# used only by `npm run seed:admin`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
